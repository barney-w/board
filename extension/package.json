{
  "name": "board",
  "displayName": "Board",
  "description": "One-click connection to your Board cloud dev environment",
  "version": "0.1.0",
  "publisher": "barney-w",
  "license": "MIT",
  "engines": { "vscode": "^1.96.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "board.configure", "title": "Board: Configure Connection (Advanced)" },
      { "command": "board.connect", "title": "Board: Connect", "icon": "$(remote)" },
      { "command": "board.start", "title": "Board: Start" },
      { "command": "board.stop", "title": "Board: Stop" },
      { "command": "board.importPass", "title": "Board: Import Pass" }
    ],
    "configuration": {
      "title": "Board",
      "properties": {
        "board.developerName": {
          "type": "string",
          "default": "",
          "description": "Your developer name (e.g. jbloggs). Lowercase, alphanumeric, max 12 chars.",
          "pattern": "^[a-z][a-z0-9]{0,11}$"
        },
        "board.environment": {
          "type": "string",
          "default": "personal",
          "enum": ["personal", "sandbox"],
          "description": "Azure environment"
        },
        "board.region": {
          "type": "string",
          "default": "australiaeast",
          "description": "Azure region (used for FQDN)"
        },
        "board.regionShort": {
          "type": "string",
          "default": "aue",
          "description": "Short region code (used for resource naming)"
        },
        "board.authMethod": {
          "type": "string",
          "default": "ssh-key",
          "enum": ["ssh-key", "entra-id"],
          "description": "SSH authentication method"
        },
        "board.autoStartVm": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the VM when connecting if it is stopped"
        },
        "board.pollIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 600,
          "description": "How often to poll VM status (seconds)"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "node esbuild.config.js",
    "build:prod": "node esbuild.config.js --production",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.0"
  }
}
