---
// Interactive terminal playground using xterm.js
---
<div class="playground-wrapper" style="max-width: 800px; margin: 2rem auto;">
  <div class="playground-header" style="background: #1e293b; padding: 0.5rem 1rem; border-radius: 8px 8px 0 0; display: flex; gap: 6px; align-items: center;">
    <span style="width: 12px; height: 12px; border-radius: 50%; background: #ef4444;"></span>
    <span style="width: 12px; height: 12px; border-radius: 50%; background: #eab308;"></span>
    <span style="width: 12px; height: 12px; border-radius: 50%; background: #22c55e;"></span>
    <span style="margin-left: auto; color: #94a3b8; font-size: 0.8rem;">Try: check, board-help, ls</span>
  </div>
  <div id="playground-terminal" style="height: 400px; border-radius: 0 0 8px 8px; overflow: hidden;"></div>
</div>

<script>
  import { Terminal } from '@xterm/xterm';
  import { FitAddon } from '@xterm/addon-fit';
  import '@xterm/xterm/css/xterm.css';
  import { executeCommand, PROMPT } from '../lib/playground-commands';

  const el = document.getElementById('playground-terminal');
  if (el) {
    const term = new Terminal({
      theme: {
        background: '#0f172a',
        foreground: '#e2e8f0',
        cursor: '#0ea5e9',
        selectionBackground: '#334155',
      },
      fontFamily: '"JetBrains Mono", "Fira Code", monospace',
      fontSize: 14,
      cursorBlink: true,
    });

    const fitAddon = new FitAddon();
    term.loadAddon(fitAddon);
    term.open(el);
    fitAddon.fit();

    let currentLine = '';

    function writePrompt() {
      term.write('\r\n' + PROMPT);
    }

    // Initial prompt
    term.write(PROMPT);

    term.onKey(({ key, domEvent }) => {
      const code = domEvent.keyCode;

      if (code === 13) {
        // Enter
        term.write('\r\n');
        const result = executeCommand(currentLine);
        if (result.output === '__CLEAR__') {
          term.clear();
          term.write(PROMPT);
        } else if (result.output) {
          // xterm needs \r\n for each line break; raw \n without \r causes
          // the cursor to move down without returning to column 0
          const formatted = result.output.replace(/\n/g, '\r\n');
          const delay = result.delay || 0;
          if (delay > 0) {
            setTimeout(() => {
              term.write(formatted);
              writePrompt();
            }, delay);
          } else {
            term.write(formatted);
            writePrompt();
          }
        } else {
          writePrompt();
        }
        currentLine = '';
      } else if (code === 8) {
        // Backspace
        if (currentLine.length > 0) {
          currentLine = currentLine.slice(0, -1);
          term.write('\b \b');
        }
      } else if (key.length === 1 && !domEvent.ctrlKey && !domEvent.altKey) {
        currentLine += key;
        term.write(key);
      }
    });

    window.addEventListener('resize', () => fitAddon.fit());
  }
</script>
